# انسخه إلى .env محلياً، وفي GitHub ضعه في Settings > Secrets and variables > Actions
ANTHROPIC_API_KEY=sk-ant-...        # الأفضل جودة (مدفوع بالاستهلاك)
OPENAI_API_KEY=                     # بديل اختياري
GEMINI_API_KEY=                     # بديل مجاني تماماً - aistudio.google.com/apikey
LLM_MODEL=claude-sonnet-4-5         # اختياري
TAVILY_API_KEY=                     # بحث حقيقي للمصادر (مجاني 1000 طلب/شهر) - مهم جداً للمصداقية
SERPER_API_KEY=                     # بديل للبحث
GSC_ACCESS_TOKEN=                   # لقراءة Search Console في التحسين الأسبوعي
